# Relay server configuration. All variables are optional; defaults shown.

# HTTP and WebSocket port.
PORT=8080

# production: WebSockets only from the same origin as the page (or ALLOWED_ORIGINS).
# development: also allows the Vite dev servers on localhost:5173 and 5174.
NODE_ENV=production

# Comma separated list of allowed Origin values; overrides the defaults above.
ALLOWED_ORIGINS=

# Folder containing monitor/dist and control/dist. Defaults to the repo's apps/ folder.
STATIC_DIR=

# How many alerts the relay keeps in memory.
RECENT_LIMIT=500

# debug | info | warn | error
LOG_LEVEL=info
