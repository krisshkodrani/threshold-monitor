# Relay server configuration. All variables are optional; defaults shown.

# HTTP and WebSocket port.
PORT=8080

# production: WebSockets only from the same origin as the page (or ALLOWED_ORIGINS).
# development: also allows the Vite dev servers on localhost:5173 and 5174.
NODE_ENV=production

# Comma separated list of allowed Origin values; overrides the defaults above.
ALLOWED_ORIGINS=

# Folder containing monitor/dist and control/dist. Defaults to the repo's apps/ folder.
STATIC_DIR=

# The SQLite file for users, sessions and alerts. Defaults to <repo>/data/threshold-monitor.db.
DATABASE_PATH=

# debug | info | warn | error
LOG_LEVEL=info

# true behind one reverse proxy (for TLS): the login limit then uses the client
# address from X-Forwarded-For. Keep false without a proxy: clients can forge it.
TRUST_PROXY=false

# The token of the sensor agent, 16 characters or more. The relay and the sensor
# use the same value. Make one: openssl rand -hex 24
# docker-compose.yml needs no token: without SENSOR_TOKEN, the relay makes one
# in SENSOR_TOKEN_FILE on its first start, and the sensor reads that file.
SENSOR_TOKEN=
SENSOR_TOKEN_FILE=

# Sensor agent only (sensor/). All optional; defaults shown.
# RELAY_URL=ws://localhost:8080/ws
# SENSOR_LABEL=Sensor 1
# SENSOR_RATE_HZ=2
