# Loaded by `pnpm dev` only. Development mode allows the Vite dev server
# origins (localhost:5173 and 5174) to open WebSockets.
NODE_ENV=development
LOG_LEVEL=debug
DEMO_USERS=true
# The sensor agent uses the same token (sensor/.env.development). Development only.
SENSOR_TOKEN=dev-sensor-token-not-for-production
